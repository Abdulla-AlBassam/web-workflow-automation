{
  "manifest_version": 3,
  "name": "Workflow Recorder",
  "version": "0.1.0",
  "description": "Records an operator demonstration (actions plus same-site network evidence) for outcome-first automation analysis.",
  "permissions": ["tabs", "storage", "webNavigation", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Workflow Recorder" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["recorder.js"], "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["nettap.js"], "run_at": "document_start", "world": "MAIN" }
  ]
}
